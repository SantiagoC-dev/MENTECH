# OPCIONAL: el proyecto mentech-escolar ya está configurado en src/lib/firebase.ts.
# Solo necesitas estas variables si conectas OTRO proyecto Firebase.
# Copia este archivo a .env.local (PowerShell: Copy-Item .env.example .env.local).
# Mantén sólo pares CLAVE=VALOR. NO pegues el bloque JavaScript de Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
